{
  "name": "online-seo-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Online SEO Portal website and consultation API",
  "scripts": {
    "start": "node backend/server.js",
    "start:backend": "node backend/server.js",
    "start:frontend": "node frontend/server.js",
    "dev:backend": "node backend/server.js",
    "dev:frontend": "node frontend/server.js",
    "dev": "concurrently -k -n backend,frontend \"npm:dev:backend\" \"npm:dev:frontend\"",
    "test": "node --test"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "mongodb": "^6.20.0",
    "nodemailer": "^10.3.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
